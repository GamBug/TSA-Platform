{
  "name": "tsa-platform",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "factory:fixture": "node tools/question-factory/generic-fixture-cli.mjs",
    "test:factory:generic": "node --test tests/ai/generic-fixture-factory.test.mjs tests/ai/generic-fixture-cli.test.mjs tests/integration/factory-bank-exam/generic-fixture-import.test.mjs",
    "test:generation": "node --test tests/ai/fake-generation-adapter.test.mjs tests/ai/generation-response-validation.test.mjs",
    "factory:reading:manual": "node tools/question-factory/manual.mjs",
    "test:factory:manual": "node --test tests/ai/manual-reading.test.mjs tests/ai/reading-factory.test.mjs",
    "test:factory:manual:transport": "npm run build && node --experimental-strip-types --test --test-concurrency=1 packages/contracts/test/factory-package-v3.test.ts tests/ai/manual-import-configuration.test.mjs tests/integration/bank/manual-factory-import.test.mjs",
    "factory:reading": "node tools/question-factory/cli.mjs",
    "test:factory:reading": "node --test tests/ai/reading-factory.test.mjs tests/integration/factory-bank-exam/*.test.mjs tests/integration/assembly/reading-experiment.test.mjs",
    "demo:factory:reading": "npm run build && node scripts/start-reading-factory-demo.mjs",
    "test:factory:reading:browser": "node scripts/verify-reading-factory-browser.mjs",
    "dev:b0": "node apps/practice-prototype/server.mjs",
    "test:b0": "node --test apps/practice-prototype/test/*.test.mjs",
    "test:b0:browser": "node scripts/verify-b0-browser.mjs",
    "test:db:preflight": "node tests/integration/database/approved-invariants/run.mjs",
    "build": "tsc -p packages/contracts/tsconfig.build.json",
    "contracts:check": "node --experimental-strip-types packages/contracts/scripts/check-openapi.ts && node --experimental-strip-types packages/contracts/scripts/check-staff-openapi.ts",
    "contracts:generate": "node --experimental-strip-types packages/contracts/scripts/generate-openapi.ts",
    "docs:check": "sed -n '/^```javascript$/,/^```$/p' docs/quality/TEST_STRATEGY.md | sed '1d;$d' | node",
    "test:corpus:private": "TSA_PRIVATE_CORPUS_TESTS=1 node --test tests/ai/corpus-reading-interactions*.test.mjs",
    "test:docs": "node --test tests/quality/docs-check.test.mjs",
    "test:built": "node packages/contracts/test/emitted-javascript.test.mjs && node --experimental-strip-types --test packages/contracts/test/staff-built.test.mjs packages/contracts/test/staff-package-export.test.mjs",
    "test:consumers": "node --test packages/contracts/test/emitted-consumers.test.mjs packages/contracts/test/stage4b-built.test.mjs",
    "contracts:consumer-check": "node --experimental-strip-types packages/contracts/scripts/check-consumer-boundaries.ts && node scripts/check-app-consumer-boundaries.mjs",
    "typecheck": "tsc -p packages/contracts/tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test packages/contracts/test/**/*.test.ts",
    "db:migrate": "node src/modules/database/migrate.mjs",
    "test:db:foundation": "node --test tests/integration/database/foundation/*.test.mjs",
    "test:auth": "node --test tests/security/auth/*.test.mjs",
    "test:bank": "node --test tests/integration/bank/*.test.mjs",
    "test:staff:review": "node --test tests/integration/bank/review-context.test.mjs tests/integration/bank/review-context-migration.test.mjs tests/integration/bank/review-demo.test.mjs",
    "test:assembly": "node --test tests/integration/assembly/*.test.mjs",
    "test:attempts": "node --test tests/integration/attempts/*.test.mjs",
    "test:scoring": "node --test tests/scoring/*.test.mjs",
    "test:grading": "node --test tests/integration/grading/*.test.mjs",
    "test:critical:student": "node --test tests/critical/student-state-machine.test.mjs",
    "test:critical:privacy": "node --test tests/critical/student-leakage.test.mjs",
    "test:recovery": "node --test tests/integration/recovery/*.test.mjs",
    "test:results": "node --test tests/integration/results/*.test.mjs",
    "test:directory": "node --test tests/integration/directory/*.test.mjs",
    "test:student": "node --test tests/integration/student-runtime/*.test.mjs tests/integration/student-security/*.test.mjs",
    "test:student:reservation": "STUDENT_RESERVATION_TEST=true node scripts/verify-student-browser.mjs",
    "test:student:reservation:late": "STUDENT_RESERVATION_LATE_TEST=true node scripts/verify-student-browser.mjs",
    "test:student:warning-resume": "STUDENT_WARNING_RESUME_TEST=true node scripts/verify-student-browser.mjs",
    "test:student:admission": "STUDENT_ADMISSION_TEST=true node scripts/verify-student-browser.mjs",
    "test:student:allocation-race": "STUDENT_ALLOCATION_RACE_TEST=true node scripts/verify-student-browser.mjs",
    "test:student:new-only": "STUDENT_NEW_ONLY_TEST=true node scripts/verify-student-browser.mjs",
    "test:student:browser": "node scripts/verify-student-browser.mjs",
    "test:student:grade-failure": "STUDENT_GRADE_FAILURE_TEST=true node scripts/verify-student-browser.mjs",
    "test:student:rate-limit": "STUDENT_RATE_LIMIT_TEST=true node scripts/verify-student-browser.mjs",
    "test:student:rate-limit:expiry": "STUDENT_RATE_LIMIT_EXPIRY_TEST=true node scripts/verify-student-browser.mjs",
    "test:student:rate-limit:expiry:attempt": "STUDENT_RATE_LIMIT_EXPIRY_TEST=true STUDENT_RATE_LIMIT_SCOPE=ATTEMPT_SAVE node scripts/verify-student-browser.mjs",
    "test:student:rate-limit:attempt": "STUDENT_RATE_LIMIT_TEST=true STUDENT_RATE_LIMIT_SCOPE=ATTEMPT_SAVE node scripts/verify-student-browser.mjs",
    "test:student:reading": "STUDENT_READING_TEST=true node scripts/verify-student-browser.mjs",
    "test:student:domains": "STUDENT_DOMAINS_TEST=true node scripts/verify-student-browser.mjs",
    "test:topics": "node --test tests/integration/topic-practice/*.test.mjs tests/integration/student-runtime/topic-*.test.mjs tests/integration/local/topic-migration.test.mjs",
    "test:topics:browser": "STUDENT_TOPIC_TEST=true node scripts/verify-student-browser.mjs",
    "test:topics:firefox": "STUDENT_TOPIC_FIREFOX=true node scripts/verify-student-firefox.mjs",
    "test:student:closed-save": "STUDENT_CLOSED_SAVE_TEST=true node scripts/verify-student-browser.mjs",
    "test:student:keyboard": "STUDENT_ACCESSIBILITY_TEST=true node scripts/verify-student-browser.mjs",
    "test:student:expiry": "STUDENT_EXPIRY_TEST=true node scripts/verify-student-browser.mjs",
    "test:student:firefox": "node scripts/verify-student-firefox.mjs",
    "test:staff:firefox": "STAFF_REVIEW_FIREFOX=true node scripts/verify-student-firefox.mjs",
    "demo:student": "npm run build && node scripts/start-student-fixture.mjs",
    "demo:staff:review": "npm run build && node scripts/start-staff-review-fixture.mjs",
    "demo:student:reading": "npm run build && STUDENT_FIXTURE_READING=true node scripts/start-student-fixture.mjs",
    "demo:student:domains": "npm run build && STUDENT_FIXTURE_DOMAINS=true node scripts/start-student-fixture.mjs",
    "dev:track-b": "npm run build && node src/local/track-b.mjs",
    "bank:owner-publish": "npm run build && node scripts/owner-publish.mjs",
    "questions:validate": "npm run build && node tools/question-bank/validate.mjs",
    "questions:schema": "npm run build && node tools/question-bank/generate-schema.mjs",
    "questions:prompt": "npm run build && node tools/question-bank/sync-prompt.mjs",
    "questions:package": "npm run build && node tools/question-bank/export-package.mjs",
    "test:question-bank": "npm run build && node --experimental-strip-types --test packages/contracts/test/question-exchange.test.ts tests/ai/question-bank-tools.test.mjs",
    "images": "node scripts/image-library.mjs",
    "test:image-library": "node --test tests/integration/bank/image-library.test.mjs tests/integration/local/image-library-migration.test.mjs",
    "bank:correct": "npm run build && node scripts/bank-correct.mjs",
    "demo:uni": "npm run build && node scripts/start-uni-demo.mjs",
    "demo:uni:rehearsal": "npm run build && node scripts/start-uni-demo.mjs --rehearsal",
    "test:demo:uni": "npm run build && node --test tests/integration/local/uni-demo-seed.test.mjs tests/integration/local/uni-demo.test.mjs",
    "test:demo:uni:browser": "npm run build && node scripts/verify-uni-demo-browser.mjs",
    "test:local": "node --test tests/integration/local/*.test.mjs",
    "test:track-b:browser": "node scripts/verify-track-b-browser.mjs",
    "test:student:review": "STUDENT_REVIEW_PRACTICE_TEST=true node scripts/verify-student-browser.mjs",
    "test:student:review:firefox": "STUDENT_REVIEW_PRACTICE_FIREFOX=true node scripts/verify-student-firefox.mjs",
    "demo:student:fixed": "npm run build && STUDENT_FIXTURE_DOMAINS=true STUDENT_FIXTURE_FIXED=true node scripts/start-student-fixture.mjs",
    "test:student:fixed": "STUDENT_FIXED_PRACTICE_TEST=true node scripts/verify-student-browser.mjs",
    "test:student:fixed:firefox": "STUDENT_FIXED_PRACTICE_FIREFOX=true node scripts/verify-student-firefox.mjs",
    "test:student:zoom:firefox": "STUDENT_NATIVE_ZOOM_FIREFOX=true node scripts/verify-student-firefox.mjs",
    "demo:student:short": "npm run build && STUDENT_FIXTURE_DOMAINS=true STUDENT_FIXTURE_SHORT=true node scripts/start-student-fixture.mjs",
    "test:student:short": "STUDENT_SHORT_PRACTICE_TEST=true node scripts/verify-student-browser.mjs",
    "test:student:short:firefox": "STUDENT_SHORT_PRACTICE_FIREFOX=true node scripts/verify-student-firefox.mjs",
    "test:media": "node --test --test-concurrency=2 tests/media/*.test.mjs tests/integration/bank/content-safety.test.mjs tests/integration/student-runtime/asset-http-boundary.test.mjs tests/integration/student-runtime/attempt-images.test.mjs tests/integration/student-runtime/image-authorization.test.mjs tests/integration/student-runtime/image-races.test.mjs tests/integration/local/image-migration.test.mjs",
    "test:student:images": "STUDENT_IMAGE_TEST=true node scripts/verify-student-browser.mjs",
    "test:student:images:firefox": "STUDENT_IMAGE_FIREFOX=true STUDENT_FIREFOX_ARTIFACT_DIR=/tmp/tsa-image-firefox-evidence node scripts/verify-student-firefox.mjs",
    "demo:student:numeric": "npm run build && STUDENT_FIXTURE_NUMERIC=true node scripts/start-student-fixture.mjs",
    "test:numeric": "npm run build && node --experimental-strip-types --test --test-concurrency=2 packages/contracts/test/numeric-response.test.ts packages/contracts/test/numeric-versioning.test.ts tests/scoring/versioned-binary.test.mjs tests/integration/bank/numeric-*.test.mjs tests/integration/student-runtime/numeric-practice.test.mjs tests/integration/local/numeric-migration.test.mjs",
    "test:student:numeric": "STUDENT_NUMERIC_TEST=true node scripts/verify-student-browser.mjs",
    "test:student:numeric:firefox": "STUDENT_NUMERIC_FIREFOX=true STUDENT_FIREFOX_ARTIFACT_DIR=/tmp/tsa-numeric-firefox-evidence node scripts/verify-student-firefox.mjs",
    "demo:student:cloze-matching": "npm run build && STUDENT_FIXTURE_CLOZE_MATCHING=true node scripts/start-student-fixture.mjs",
    "test:student:cloze-matching:api": "node --test apps/practice-prototype/test/cloze-matching-api.test.mjs apps/practice-prototype/test/persistent-api.test.mjs apps/practice-prototype/test/client-api.test.mjs",
    "test:staff:cloze-matching": "npm run build && TRACK_B_CLOZE_MATCHING_TEST=true node scripts/verify-track-b-browser.mjs",
    "test:student:cloze-matching": "STUDENT_CLOZE_MATCHING_TEST=true node scripts/verify-student-browser.mjs",
    "test:student:cloze-matching:firefox": "STUDENT_CLOZE_MATCHING_FIREFOX=true STUDENT_FIREFOX_ARTIFACT_DIR=/tmp/tsa-cloze-matching-firefox-evidence node scripts/verify-student-firefox.mjs",
    "demo:student:simulation": "npm run build && STUDENT_FIXTURE_SIMULATION=true node scripts/start-student-fixture.mjs",
    "test:simulation": "npm run build && node --experimental-strip-types --test packages/contracts/test/simulation-v3.test.ts tests/integration/local/simulation-migration.test.mjs tests/integration/student-runtime/full-simulation.test.mjs",
    "test:student:simulation": "node scripts/verify-simulation-browser.mjs chromium",
    "test:student:simulation:firefox": "node scripts/verify-simulation-browser.mjs firefox"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "katex": "0.19.0",
    "pg": "8.23.1",
    "sharp": "0.35.5"
  }
}
