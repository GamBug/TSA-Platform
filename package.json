{
  "name": "tsa-platform",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": "24.18.0",
    "npm": "11.16.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:b0": "node apps/practice-prototype/server.mjs",
    "test:b0": "node --test apps/practice-prototype/test/*.test.mjs",
    "test:b0:browser": "node scripts/verify-b0-browser.mjs",
    "test:db:preflight": "node tests/integration/database/approved-invariants/run.mjs",
    "build": "tsc -p packages/contracts/tsconfig.build.json",
    "contracts:check": "node --experimental-strip-types packages/contracts/scripts/check-openapi.ts",
    "contracts:generate": "node --experimental-strip-types packages/contracts/scripts/generate-openapi.ts",
    "docs:check": "sed -n '/^```javascript$/,/^```$/p' docs/quality/TEST_STRATEGY.md | sed '1d;$d' | node",
    "test:built": "node packages/contracts/test/emitted-javascript.test.mjs",
    "test:consumers": "node --test packages/contracts/test/emitted-consumers.test.mjs packages/contracts/test/stage4b-built.test.mjs",
    "contracts:consumer-check": "node --experimental-strip-types packages/contracts/scripts/check-consumer-boundaries.ts && node scripts/check-app-consumer-boundaries.mjs",
    "typecheck": "tsc -p packages/contracts/tsconfig.json --noEmit",
    "test": "node --experimental-strip-types --test packages/contracts/test/**/*.test.ts",
    "db:migrate": "node src/modules/database/migrate.mjs",
    "test:db:foundation": "node --test tests/integration/database/foundation/*.test.mjs",
    "test:auth": "node --test tests/security/auth/*.test.mjs",
    "test:bank": "node --test tests/integration/bank/*.test.mjs",
    "test:assembly": "node --test tests/integration/assembly/*.test.mjs",
    "test:attempts": "node --test tests/integration/attempts/*.test.mjs",
    "test:scoring": "node --test tests/scoring/*.test.mjs",
    "test:grading": "node --test tests/integration/grading/*.test.mjs",
    "test:recovery": "node --test tests/integration/recovery/*.test.mjs",
    "test:results": "node --test tests/integration/results/*.test.mjs",
    "test:directory": "node --test tests/integration/directory/*.test.mjs",
    "test:student": "node --test tests/integration/student-runtime/*.test.mjs tests/integration/student-security/*.test.mjs",
    "test:student:browser": "node scripts/verify-student-browser.mjs",
    "test:student:reading": "STUDENT_READING_TEST=true node scripts/verify-student-browser.mjs",
    "test:student:domains": "STUDENT_DOMAINS_TEST=true node scripts/verify-student-browser.mjs",
    "test:student:closed-save": "STUDENT_CLOSED_SAVE_TEST=true node scripts/verify-student-browser.mjs",
    "test:student:keyboard": "STUDENT_ACCESSIBILITY_TEST=true node scripts/verify-student-browser.mjs",
    "test:student:expiry": "STUDENT_EXPIRY_TEST=true node scripts/verify-student-browser.mjs",
    "test:student:firefox": "node scripts/verify-student-firefox.mjs",
    "demo:student": "npm run build && node scripts/start-student-fixture.mjs",
    "demo:student:reading": "npm run build && STUDENT_FIXTURE_READING=true node scripts/start-student-fixture.mjs",
    "demo:student:domains": "npm run build && STUDENT_FIXTURE_DOMAINS=true node scripts/start-student-fixture.mjs",
    "dev:track-b": "npm run build && node src/local/track-b.mjs",
    "test:local": "node --test tests/integration/local/*.test.mjs",
    "test:track-b:browser": "node scripts/verify-track-b-browser.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
